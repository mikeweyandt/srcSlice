+ * itself when there is none (the last match wins, as the loop it replaces did). The
+ * previous element's answer is reused when the pointer and its text are the same.
+ */
+static inline const xmlChar * canonical_namespace(namespace_cache & cache, const srcml_element & root, int first, const xmlChar * value) {
+
+    if(value == NULL) return NULL;
+
+    if(value == cache.in && strcmp((const char *)value, cache.text.c_str()) == 0) return cache.out;
+
+    const xmlChar * out = value;
+    int ns_length = root.nb_namespaces * 2;
