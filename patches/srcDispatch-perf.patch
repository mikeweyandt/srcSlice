+
+#ifndef INCLUDED_SRCDISPATCH_ANY_HPP
+#define INCLUDED_SRCDISPATCH_ANY_HPP
+
+#include <cstddef>
+#include <new>
+#include <type_traits>
+#include <typeinfo>
+#include <utility>
+
+namespace srcDispatch {
+
+    class bad_any_cast : public std::bad_cast {
+    public:
+        const char* what() const noexcept override { return "bad srcDispatch::any_cast"; }
+    };
+
+    // The srcDispatch::Any of the object model, with room in place for what it holds (perf plan M7,
+    // first part). Every child link of the model is a shared_ptr to a data struct held in a
+    // srcDispatch::Any; srcDispatch::Any keeps anything larger than one pointer on the heap, so each link
+    // cost a heap block of its own next to the control block the shared_ptr already has.
+    // This one stores values of up to two pointers in place (a shared_ptr is exactly that)
+    // and falls back to the heap for anything larger. Same operations as the srcDispatch::Any the
+    // code used: construction and assignment from any value, copy, move, type(),
+    // has_value(), reset(), and any_cast by value or by pointer.
+    class Any {
+    public:
+        Any() noexcept = default;
+        Any(const Any& other) { if(other.manager) other.manager(Op::Copy, &other, this); }
+        Any(Any&& other) noexcept {
+            if(other.manager) {
+                other.manager(Op::Move, &other, this);
+                other.manager = nullptr;
+            }
+        }
+        template<class T, class D = std::decay_t<T>,
+                 std::enable_if_t<!std::is_same_v<D, Any>, int> = 0>
+        Any(T&& value) { Construct<D>(std::forward<T>(value)); }
+        ~Any() { reset(); }
+
+        Any& operator=(const Any& other) {
+            if(this != &other) {
+                Any copy(other);
+                swap(copy);
+            }
+            return *this;
+        }
+        Any& operator=(Any&& other) noexcept {
+            if(this != &other) {
+                reset();
+                if(other.manager) {
+                    other.manager(Op::Move, &other, this);
+                    other.manager = nullptr;
+                }
+            }
+            return *this;
+        }
+        template<class T, class D = std::decay_t<T>,
+                 std::enable_if_t<!std::is_same_v<D, Any>, int> = 0>
+        Any& operator=(T&& value) {
+            Any fresh(std::forward<T>(value));
+            swap(fresh);
+            return *this;
+        }
+
+        void reset() noexcept {
+            if(manager) {
+                manager(Op::Destroy, this, nullptr);
+                manager = nullptr;
+            }
+        }
+        bool has_value() const noexcept { return manager != nullptr; }
+        const std::type_info& type() const noexcept {
+            if(!manager) return typeid(void);
+            const std::type_info* info = nullptr;
+            manager(Op::Type, this, &info);
+            return *info;
+        }
+        void swap(Any& other) noexcept {
+            Any tmp(std::move(other));
+            other = std::move(*this);
+            *this = std::move(tmp);
+        }
+
+    private:
+        enum class Op { Copy, Move, Destroy, Type, Get };
+
+        static constexpr std::size_t StorageSize = 2 * sizeof(void*);
+        template<class T>
+        static constexpr bool Inline = sizeof(T) <= StorageSize && alignof(T) <= alignof(void*)
+                                       && std::is_nothrow_move_constructible_v<T>;
+
+        alignas(void*) unsigned char storage[StorageSize];
+        void (*manager)(Op, const Any*, void*) = nullptr;
+
+        template<class T>
+        T* Slot() { return Inline<T> ? reinterpret_cast<T*>(storage) : *reinterpret_cast<T**>(storage); }
+        template<class T>
+        const T* Slot() const { return Inline<T> ? reinterpret_cast<const T*>(storage) : *reinterpret_cast<T* const*>(storage); }
+
+        template<class T, class... Args>
+        void Construct(Args&&... args) {
+            if constexpr(Inline<T>) {
+                ::new (static_cast<void*>(storage)) T(std::forward<Args>(args)...);
+            } else {
+                *reinterpret_cast<T**>(storage) = new T(std::forward<Args>(args)...);
+            }
+            manager = &Manage<T>;
+        }
+
+        template<class T>
+        static void Manage(Op op, const Any* self, void* arg) {
+            switch(op) {
+                case Op::Copy:
+                    static_cast<Any*>(arg)->Construct<T>(*self->Slot<T>());
+                    break;
+                case Op::Move:
+                    if constexpr(Inline<T>) {
+                        static_cast<Any*>(arg)->Construct<T>(std::move(*const_cast<Any*>(self)->Slot<T>()));
+                        const_cast<Any*>(self)->Slot<T>()->~T();
+                    } else {
+                        // the heap object changes hands
+                        *reinterpret_cast<T**>(static_cast<Any*>(arg)->storage) = const_cast<Any*>(self)->Slot<T>();
+                        static_cast<Any*>(arg)->manager = &Manage<T>;
+                    }
+                    break;
+                case Op::Destroy:
+                    if constexpr(Inline<T>) {
+                        const_cast<Any*>(self)->Slot<T>()->~T();
+                    } else {
+                        delete const_cast<Any*>(self)->Slot<T>();
+                    }
+                    break;
+                case Op::Type:
+                    *static_cast<const std::type_info**>(arg) = &typeid(T);
+                    break;
+                case Op::Get:
+                    *static_cast<void**>(arg) = const_cast<T*>(self->Slot<T>());
+                    break;
+            }
+        }
+
+        template<class T> friend T* any_cast(Any* any) noexcept;
+        template<class T> friend const T* any_cast(const Any* any) noexcept;
+    };
+
+    template<class T>
+    T* any_cast(Any* any) noexcept {
+        if(!any || !any->manager || any->type() != typeid(T)) return nullptr;
+        void* p = nullptr;
+        any->manager(Any::Op::Get, any, &p);
+        return static_cast<T*>(p);
+    }
+    template<class T>
+    const T* any_cast(const Any* any) noexcept {
+        return any_cast<T>(const_cast<Any*>(any));
+    }
+    template<class T>
+    T any_cast(const Any& any) {
+        using U = std::remove_cv_t<std::remove_reference_t<T>>;
+        const U* p = any_cast<U>(&any);
+        if(!p) throw bad_any_cast();
+        return static_cast<T>(*p);
+    }
+    template<class T>
+    T any_cast(Any& any) {
+        using U = std::remove_cv_t<std::remove_reference_t<T>>;
+        U* p = any_cast<U>(&any);
+        if(!p) throw bad_any_cast();
+        return static_cast<T>(*p);
+    }
+    template<class T>
+    T any_cast(Any&& any) {
+        using U = std::remove_cv_t<std::remove_reference_t<T>>;
+        U* p = any_cast<U>(&any);
+        if(!p) throw bad_any_cast();
+        return static_cast<T>(std::move(*p));
+    }
+
+}
