 }
 
+// "line:column" made of digits only is parsed in place (perf: the two substr + two stoi per
+// position were 2.6 % of a run); anything else, including empty text, signs, spaces, trailing
+// text or more than nine digits, takes the std::string constructor so the behaviour (and its
+// exceptions) is unchanged.
+Position::Position(const char* posStr) : Position() {
+
+   const char* p = posStr;
+   std::size_t lineValue = 0, columnValue = 0;
+   int digits = 0;
+
+   if(p != nullptr) {
+      for(; *p >= '0' && *p <= '9' && digits < 10; ++p, ++digits) lineValue = lineValue * 10 + (*p - '0');
+      if(digits > 0 && digits < 10 && *p == ':') {
+         ++p;
+         digits = 0;
+         for(; *p >= '0' && *p <= '9' && digits < 10; ++p, ++digits) columnValue = columnValue * 10 + (*p - '0');
+         if(digits > 0 && digits < 10 && *p == '\0') {
+            line = lineValue;
+            column = columnValue;
+            return;
+         }
+      }
+   }
+
+   *this = Position(std::string(posStr ? posStr : ""));
+
+}
+
 std::size_t Position::GetLine() const {
    return line;
 }
